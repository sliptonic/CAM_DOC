{
  "title": "gypsy review",
  "type": "object",
  "required": [
    "goals",
    "findings",
    "confirmed",
    "untested",
    "merge",
    "notes"
  ],
  "properties": {
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "goal",
          "met",
          "where",
          "note"
        ],
        "properties": {
          "goal": {
            "type": "string"
          },
          "met": {
            "enum": [
              "yes",
              "partly",
              "no"
            ]
          },
          "where": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "kind",
          "severity",
          "text",
          "evidence",
          "fix",
          "brief_fact",
          "brief_correction"
        ],
        "properties": {
          "page": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "wrong",
              "contradiction",
              "repeat",
              "excluded",
              "missing",
              "term",
              "figure",
              "guidance"
            ]
          },
          "severity": {
            "enum": [
              "must",
              "should"
            ]
          },
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "brief_fact": {
            "type": "string"
          },
          "brief_correction": {
            "type": "string"
          }
        }
      }
    },
    "confirmed": {
      "type": "integer"
    },
    "untested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "merge": {
      "enum": [
        "yes",
        "no"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
